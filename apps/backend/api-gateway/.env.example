# API Gateway (:3000) — proxy perimetral liviano, SIN base de datos.
PORT=3000

# Secreto compartido para verificar la firma del JWT (mismo que auth-service).
JWT_SECRET=secret_key

# Orígenes web permitidos por CORS, separados por coma (panel React).
# La app React Native no necesita CORS. Si se deja vacío: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL de cada microservicio (Diseño §14.1). Usar 127.0.0.1: los servicios solo escuchan en la interfaz local.
SVC_AUTH_URL=http://127.0.0.1:3001
SVC_CLIENTS_URL=http://127.0.0.1:3002
SVC_CLINICAL_URL=http://127.0.0.1:3003
SVC_SCHEDULING_URL=http://127.0.0.1:3004
SVC_NOTIFICATIONS_URL=http://127.0.0.1:3005
SVC_CATALOG_URL=http://127.0.0.1:3006
