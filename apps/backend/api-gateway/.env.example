# API Gateway (:3000) — proxy perimetral liviano, SIN base de datos.
PORT=3000

# Secreto compartido para verificar la firma del JWT (mismo que auth-service).
JWT_SECRET=secret_key

# URLs para CORS
FRONTEND_WEB_ORIGIN_URL=http://localhost:5173
FRONTEND_MOVILE_ORIGIN_URL=http://127.0.0.1:5173

# Origen para los microservicios
ORIGIN_URL=http://localhost

# Prefijo para la comunicación hacia los microservicios
AUTH_SERVICE_PREFIX=/v1/auth
CLIENTS_SERVICE_PREFIX=/v1/clients
PETS_SERVICE_PREFIX=/v1/pets
CLINICAL_SERVICE_PREFIX=/v1/clinical
SCHEDULING_SERVICE_PREFIX=/v1/scheduling
NOTIFICATIONS_SERVICE_PREFIX=/v1/notifications
CATALOG_SERVICE_PREFIX=/v1/catalog

# Puertos de los servicios
AUTH_SERVICE_PORT=3001
CLIENTS_PETS_SERVICE_PORT=3002
CLINICAL_SERVICE_PORT=3003
SCHEDULING_SERVICE_PORT=3004
NOTIFICATIONS_SERVICE_PORT=3005
CATALOG_SERVICE_PORT=3006


# 2. Protección de Rutas Internas (/internal/*)
# Clave secreta compartida leída por InternalKeyGuard para autorizar la cabecera X-Internal-Key 
# en peticiones síncronas entre microservicios (timeout max 3s)
INTERNAL_KEY=vetconecta_shared_internal_api_key_secret
INTERNAL_API_KEY=vetconecta_shared_internal_api_key_secret