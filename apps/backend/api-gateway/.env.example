# API Gateway (:3000) - proxy perimetral liviano, SIN base de datos.
PORT=3000

# Secreto para verificar la firma del JWT. Mismo valor que en auth-service.
# Minimo 32 caracteres, aleatorio. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR_generar_secreto_aleatorio

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Clave compartida para rutas /internal (cabecera X-Internal-Key).
# Mismo valor en todos los servicios. Minimo 16 caracteres, aleatorio.
INTERNAL_KEY=CAMBIAR_generar_clave_aleatoria

# Origen para los microservicios
ORIGIN_URL=http://localhost

# Prefijos para la comunicacion hacia los microservicios
AUTH_SERVICE_PREFIX=/v1/auth
CLIENTS_SERVICE_PREFIX=/v1/clients
PETS_SERVICE_PREFIX=/v1/pets
CLINICAL_SERVICE_PREFIX=/v1/clinical
SCHEDULING_SERVICE_PREFIX=/v1/scheduling
NOTIFICATIONS_SERVICE_PREFIX=/v1/notifications
CATALOG_SERVICE_PREFIX=/v1/catalog

# Puertos de los servicios
AUTH_SERVICE_PORT=3001
CLIENTS_PETS_SERVICE_PORT=3002
CLINICAL_SERVICE_PORT=3003
SCHEDULING_SERVICE_PORT=3004
NOTIFICATIONS_SERVICE_PORT=3005
CATALOG_SERVICE_PORT=3006