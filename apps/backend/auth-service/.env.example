PORT=3001
JWT_SECRET=CAMBIAR_generar_secreto_aleatorio
JWT_EXPIRES_IN=15m

CLIENTS_SERVICE_URL=http://localhost:3002

# [X1] Base de datos propia del servicio (una base por microservicio).
# Las tablas viven en el esquema `auth` dentro de esta base.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=auth_db

# Protección de Rutas Internas (/internal/*)
# Clave secreta compartida leída por InternalKeyGuard para autorizar la cabecera X-Internal-Key 
# en peticiones síncronas entre microservicios (timeout max 3s)
INTERNAL_KEY=CAMBIAR_generar_clave_aleatoria
