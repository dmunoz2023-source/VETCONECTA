{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "../../../",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,

    "paths": {
      "@app/shared/*": ["../../../libs/shared/src/*"]
    },
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  
  "exclude": ["node_modules", "dist"]
}