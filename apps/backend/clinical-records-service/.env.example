PORT=3003

# Conexión a la única instancia de PostgreSQL de VetConecta.
# Lo que aísla a clinical-records-service es el esquema `clinical` (fijo en
# database.module.ts), no una base separada.
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=secret_key
DB_SCHEMA=clinical

# Llamadas internas a otros servicios (F3). Los tiempos de espera son de 3 s.
CLIENTS_SERVICE_URL=http://localhost:3002
SCHEDULING_SERVICE_URL=http://localhost:3004
CATALOG_SERVICE_URL=http://localhost:3006

# Protección de Rutas Internas (/internal/*)
# Clave secreta compartida leída por InternalKeyGuard para autorizar la cabecera X-Internal-Key
# en peticiones síncronas entre microservicios (timeout max 3s)
INTERNAL_KEY=vetconecta_shared_internal_api_key_secret
INTERNAL_API_KEY=vetconecta_shared_internal_api_key_secret
