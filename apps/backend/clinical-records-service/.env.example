PORT=3003

# Conexión a la única instancia de PostgreSQL de VetConecta.
# En local es el mismo servidor para todos los servicios; lo que aísla a
# clinical-records-service es DB_SCHEMA, no una base separada.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetconecta
DB_SCHEMA=clinical

# Llamadas internas a otros servicios (F3). Los tiempos de espera son de 3 s.
CLIENTS_SERVICE_URL=http://localhost:3002
SCHEDULING_SERVICE_URL=http://localhost:3004
CATALOG_SERVICE_URL=http://localhost:3006
# Mismo valor que usan los demás servicios en INTERNAL_KEY (cabecera X-Internal-Key)
INTERNAL_KEY=clave_interna_compartida
