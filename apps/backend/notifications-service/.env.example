PORT=3005
DATABASE_URL=url_postgresql
DB_SCHEMA=notifications

# Recordatorios (valores por defecto)
REMINDER_LEAD_MINUTES=1440
REMINDER_POLL_SECONDS=300
REMINDER_MAX_ATTEMPTS=3

# Protección de Rutas Internas (/internal/*)
# Clave secreta compartida leída por InternalKeyGuard para autorizar la cabecera X-Internal-Key
# en peticiones síncronas entre microservicios (timeout max 3s)
INTERNAL_KEY=vetconecta_shared_internal_api_key_secret
INTERNAL_API_KEY=vetconecta_shared_internal_api_key_secret

# Firebase (credenciales en el .env local)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=