{
  "name": "notifications-service",
  "version": "0.0.1",
  "description": "Microservicio de notificaciones de VetConecta",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/backend/notifications-service/src/main.js",
    "test": "jest",
    "test:integration": "jest --runInBand --testRegex=.*[.]e2e-spec[.]ts$"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/shared/(.*)$": "<rootDir>/../../../../libs/shared/src/$1",
      "^@nestjs/common$": "<rootDir>/../../../../apps/backend/notifications-service/node_modules/@nestjs/common"
    }
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0"
  }
}
