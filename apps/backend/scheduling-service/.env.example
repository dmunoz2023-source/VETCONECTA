PORT=3004

# Conexión a la única instancia de PostgreSQL de VetConecta.
# En local normalmente es el mismo servidor para todos los servicios;
# lo que aísla a scheduling-service es DB_SCHEMA, no una base separada.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetconecta
DB_SCHEMA=scheduling

# Llamadas internas a otros servicios (G2)
CLIENTS_SERVICE_URL=http://localhost:3002
NOTIFICATIONS_SERVICE_URL=http://localhost:3005
# Mismo valor que usa notifications-service en INTERNAL_KEY
INTERNAL_KEY=clave_interna_compartida
