{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/shared/(.*)$": "<rootDir>/../../../libs/shared/src/$1"
  },
  "setupFiles": ["<rootDir>/test/helpers/setup-env.ts"],
  "testTimeout": 30000
}
